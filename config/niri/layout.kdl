layout {
    focus-ring {
        width 2
        }
    gaps 2
    background-color "transparent"
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 1.0
     }
     default-column-width {}

    border {
        
        width 2
    }
    shadow {
    }
    struts {
    }
}
        window-rule {
        geometry-corner-radius 0
        clip-to-geometry true
        tiled-state true
        draw-border-with-background false
        }
